# Раздача витрин новых тем (design.md блока 5, В5-1 Б): метка хоста → указатель → таблица раздачи сборки → файл
# по отпечатку. Свой образ рядом с прокси нынешних магазинов (В5-3 А): их конфиги и роутеры этот файл не трогает.
# Переменные окружения (подставляет образ nginx): MINIO_URL, BUCKET, RENDERER_URL, DRAW_TIMEOUT, ROUTES_MEMORY,
# DRAW_RATE_SHOP, DRAW_BURST_SHOP, DRAW_RATE_ALL, DRAW_BURST_ALL, INDEXNOW_KEY, STOREFRONT_CSP.
# Объекты — в ${BUCKET}/storefront/: pointers/<метка>.json, routes/<магазин>/<сборка>.json, drawn/<магазин>/<сборка>.json,
# entities/<магазин>.json, blobs/<2 знака>/<отпечаток>.

js_engine qjs;
js_path /etc/nginx/njs/;
js_import serve from serve.js;

# Строки таблиц раздачи. Вытеснения нет: зона полна — раздача отвечает 503, а не теряет строки молча.
js_shared_dict_zone zone=sf_routes:${ROUTES_MEMORY} type=string timeout=1h;

# Копии страниц 502 магазинов (блок 7 «Секций и SDK», часть 7а): по метке хоста — хеш и HTML 502.html текущей сборки.
# Места мало — старые копии вытесняются (evict): магазин без копии получает нейтральную страницу, раздача работает.
# evict в nginx 1.31 требует timeout=; 7d — дольше sf_routes (1h), копия обновляется при каждой раскладке таблицы.
js_shared_dict_zone zone=sf_unavailable:8m type=string timeout=7d evict;

# Заголовки файла: serve.js кладёт их сюда перед переходом в /_blob/, фильтр заголовков ставит в ответ.
js_var $sf_type;
js_var $sf_cache;
js_var $sf_etag;
js_var $sf_modified;
# CSP (блок 13 «Секций и SDK», часть 13в): режим из окружения образа (report, enforce, другое — без заголовка) и
# заголовки HTML-файла — sendFile записывает их сюда перед переходом в /_blob/.
js_var $sf_csp_mode "${STOREFRONT_CSP}";
js_var $sf_csp;

proxy_cache_path /var/cache/nginx/sf-meta keys_zone=sf_meta:10m max_size=256m inactive=10m use_temp_path=off;
proxy_cache_path /var/cache/nginx/sf-blobs levels=1:2 keys_zone=sf_blobs:10m max_size=1g inactive=7d use_temp_path=off;
proxy_cache_path /var/cache/nginx/sf-draw keys_zone=sf_draw:10m max_size=256m inactive=10m use_temp_path=off;

map $host $merfy_label {
    ~^(?<lbl>[^.]+)\.    $lbl;
    default              "";
}

# Защита рисовальщика от перебора (В5-7): не больше DRAW_RATE_SHOP вызовов на магазин и DRAW_RATE_ALL на всю раздачу,
# сверх лимита — 503 (сервер на 127.0.0.1:8081 ниже). Ключ общего лимита — одна строка на всех.
map $host $sf_everyone {
    default all;
}
limit_req_zone $arg_shop zone=sf_draw_shop:10m rate=${DRAW_RATE_SHOP};
limit_req_zone $sf_everyone zone=sf_draw_all:1m rate=${DRAW_RATE_ALL};

server {
    listen 80;
    server_name _;
    absolute_redirect off;
    port_in_redirect off;
    # Docker DNS: адреса хранилища и рисовальщика ищутся при запросе, nginx стартует и без них.
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 2s;
    # Таблица раздачи большого магазина приходит подзапросом целиком.
    subrequest_output_buffer_size 16m;

    location = /health {
        return 200 "ok\n";
    }

    location = /_storefront/status {
        allow 127.0.0.1;
        deny all;
        js_content serve.status;
    }

    location / {
        js_content serve.serve;
    }

    # Файл ключа IndexNow — на любом хосте (design.md, раздел 4); уведомления шлёт сборщик (блок 6).
    location = /${INDEXNOW_KEY}.txt {
        default_type "text/plain; charset=utf-8";
        return 200 "${INDEXNOW_KEY}";
    }

    # Указатель и таблицы: кэш на секунду; хранилище недоступно — последняя копия из кэша.
    location ~ ^/_meta/(?<sf_object>.+)$ {
        internal;
        proxy_pass ${MINIO_URL}/${BUCKET}/storefront/$sf_object;
        proxy_http_version 1.1;
        # Подзапрос наследует Accept-Encoding покупателя, и MinIO отдаёт таблицу сжатой — JSON.parse в njs падает, раздача
        # отвечает 503. Таблицы читает njs, сжатие им не нужно.
        proxy_set_header Accept-Encoding "";
        proxy_cache sf_meta;
        proxy_cache_key $sf_object;
        proxy_cache_valid 200 404 1s;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_connect_timeout 2s;
        proxy_read_timeout 2s;
    }

    # Файл сборки по отпечатку не меняется: кэш на месяц.
    location ~ "^/_blob/(?<sf_blob>[0-9a-f]{2}/[0-9a-f]{64})$" {
        internal;
        proxy_pass ${MINIO_URL}/${BUCKET}/storefront/blobs/$sf_blob;
        proxy_http_version 1.1;
        proxy_cache sf_blobs;
        proxy_cache_key $sf_blob;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        # Тип содержимого ставит фильтр заголовков из таблицы раздачи. Тип хранилища прячем: иначе nginx берёт из него
        # кодировку и дописывает её второй раз — «text/html; charset=utf-8; charset=utf-8».
        proxy_hide_header Content-Type;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Xss-Protection;
        proxy_hide_header Vary;
        proxy_hide_header X-Ratelimit-Limit;
        proxy_hide_header X-Ratelimit-Remaining;
        proxy_intercept_errors on;
        error_page 403 404 500 502 503 504 = @unavailable;
        js_header_filter serve.fileHeaders;
    }

    # Файл сборки, тело которого читает сам njs (страница 404 темы): без сжатия, иначе njs получит байты gzip и отдаст их
    # покупателю как страницу. Ключ кэша свой — сжатые копии из /_blob/ сюда не попадают.
    location ~ "^/_text/(?<sf_text>[0-9a-f]{2}/[0-9a-f]{64})$" {
        internal;
        proxy_pass ${MINIO_URL}/${BUCKET}/storefront/blobs/$sf_text;
        proxy_http_version 1.1;
        proxy_set_header Accept-Encoding "";
        proxy_cache sf_blobs;
        proxy_cache_key text:$sf_text;
        proxy_cache_valid 200 30d;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    # Рисовальщик (Св-1 В): одна страница по запросу. Места и тайм-аут решает блок 6 (В6-2), здесь — ожидание и кэш:
    # одинаковые промахи склеиваются в один вызов, «такого нет» помним минуту (В5-7). Лимит стоит в сервере ниже: так
    # он считает настоящие вызовы рисовальщика, а не ответы из этого кэша.
    location = /_draw {
        internal;
        proxy_pass http://127.0.0.1:8081/draw$is_args$args;
        proxy_http_version 1.1;
        # Страницу рисовальщика njs читает текстом и отдаёт сам — сжатие ему не нужно, как таблицам и странице 404.
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout ${DRAW_TIMEOUT};
        proxy_cache sf_draw;
        proxy_cache_key $args;
        proxy_cache_valid 200 404 1m;
        proxy_cache_lock on;
        proxy_cache_lock_timeout ${DRAW_TIMEOUT};
    }

    # Файл сборки не прочитался (часть 7а): 503 с Retry-After и копией 502.html магазина, её нет — нейтральная страница.
    location @unavailable {
        js_content serve.unavailable;
    }
}

# Вызов рисовальщика под лимитом (В5-7): сверх лимита — 503, раздача отвечает «временно недоступно». Слушает только
# внутри контейнера, сюда ходит /_draw.
server {
    listen 127.0.0.1:8081;
    server_name _;
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 2s;

    location = /draw {
        limit_req zone=sf_draw_shop burst=${DRAW_BURST_SHOP} nodelay;
        limit_req zone=sf_draw_all burst=${DRAW_BURST_ALL} nodelay;
        limit_req_status 503;
        proxy_pass ${RENDERER_URL}/draw$is_args$args;
        proxy_http_version 1.1;
        proxy_connect_timeout 1s;
        proxy_read_timeout ${DRAW_TIMEOUT};
    }
}
