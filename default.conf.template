server {
    listen 80;
    server_name _;

    # DNS resolver для динамических upstream (Docker internal DNS)
    resolver 127.0.0.11 valid=30s ipv6=off;
    resolver_timeout 5s;

    # CORS wildcard для public static assets (icons, images, fonts) — preview
    # iframe конструктора грузит SVG для mask-image и PNG/WEBP для Hero
    # background с cross-origin (customize.merfy.ru ↔ <site>.merfy.ru).
    # MinIO по умолчанию отдаёт `Access-Control-Allow-Origin: https://gateway.merfy.ru`,
    # что не покрывает customize.merfy.ru → CORS REJECT → icons как black
    # boxes, Hero пустой. Public assets без credentials → `*` безопасно.
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    add_header Access-Control-Allow-Origin "*" always;
    add_header Cross-Origin-Resource-Policy "cross-origin" always;

    # Health check — проверяем реальный upstream (MinIO)
    location /health {
        set $minio_health ${MINIO_URL}/${BUCKET}/${SITE_PATH}/index.html;
        proxy_pass $minio_health;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
        # If MinIO responds (any status) → nginx returns it
        # If MinIO is unreachable → nginx returns 502 → Coolify marks unhealthy
    }

    # Корень сайта → index.html
    location = / {
        set $upstream ${MINIO_URL}/${BUCKET}/${SITE_PATH}/index.html;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_intercept_errors on;
        error_page 404 /404.html;
        error_page 500 502 503 504 /50x.html;
    }

    # Каноникализация product URL: /product?id=<x> → 301 /product/<x>
    # Exact-match нужен, чтобы редирект сработал ДО generic `location /`.
    # Без ?id отдаём «голую» универсальную страницу product/index.html.
    location = /product {
        if ($arg_id) {
            return 301 /product/$arg_id;
        }

        set $upstream ${MINIO_URL}/${BUCKET}/${SITE_PATH}/product/index.html;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_intercept_errors on;
        error_page 404 /404.html;
        error_page 500 502 503 504 /50x.html;
    }

    # Legacy множественное число → каноническое единственное:
    # /products/<x> → 301 /product/<x>. Regex outranks prefix `location /`.
    location ~ ^/products/(.+?)/?$ {
        return 301 /product/$1;
    }

    # Все остальные пути
    location / {
        # Проверяем наличие файла, потом index.html в директории
        set $upstream ${MINIO_URL}/${BUCKET}/${SITE_PATH}$uri;

        # Если путь заканчивается на / - добавляем index.html
        if ($uri ~ "/$") {
            set $upstream ${MINIO_URL}/${BUCKET}/${SITE_PATH}${uri}index.html;
        }

        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        # При 404 пробуем /index.html для директорий
        proxy_intercept_errors on;
        error_page 404 = @try_index;
        error_page 500 502 503 504 /50x.html;
    }

    # Fallback для директорий без trailing slash
    location @try_index {
        set $upstream ${MINIO_URL}/${BUCKET}/${SITE_PATH}$uri/index.html;
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_hide_header x-amz-id-2;
        proxy_hide_header x-amz-request-id;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_intercept_errors on;
        error_page 404 /404.html;
        error_page 500 502 503 504 /50x.html;
    }

    # Обработка ошибок
    error_page 404 /404.html;
    location = /404.html {
        internal;
        return 404 '<!DOCTYPE html><html><head><title>404</title></head><body><h1>Page Not Found</h1></body></html>';
        add_header Content-Type text/html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        internal;
        return 500 '<!DOCTYPE html><html><head><title>Server Error</title></head><body><h1>Server Error</h1></body></html>';
        add_header Content-Type text/html;
    }
}
