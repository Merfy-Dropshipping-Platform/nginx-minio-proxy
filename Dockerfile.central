FROM nginx:alpine

# Центральный прокси витрин: конфиг central.conf.template (см. комментарий в нём).
# Сборка: Coolify, dockerfile_location=/Dockerfile.central. Прод-контейнеры merfy-sites-proxy собраны вручную (22.06.2026) —
# при переводе прода на этот Dockerfile проверить эквивалентность конфигов (diff с /etc/nginx/conf.d/default.conf).
COPY central.conf.template /etc/nginx/templates/default.conf.template

ENV MINIO_URL=https://minio.example.com
ENV BUCKET=merfy-sites
ENV SITE_PATH=

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
